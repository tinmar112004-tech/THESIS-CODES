<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Service Agent Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
</head>

<body class="font-sans bg-[#f0f4f8] text-[#1a5276]">
  <div id="app" class="flex h-screen overflow-hidden">

    <!-- Sidebar -->
    <aside
      :class="expanded ? 'w-60' : 'w-16'"
      class="flex-shrink-0 bg-gradient-to-b from-[#0d2844] to-[#1a4a7a] text-white flex flex-col shadow-2xl overflow-hidden transition-all duration-300 ease-in-out"
      @mouseenter="onMouseEnter"
      @mouseleave="onMouseLeave"
    >
      <!-- Logo -->
      <div class="flex items-center gap-3 px-3.5 py-5 border-b border-white/10 min-h-[72px] cursor-pointer flex-shrink-0" @click="toggleSidebar">
        <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center flex-shrink-0 border border-white/20 overflow-hidden">
          <img src="hyundai-appliances-logo.jpg" alt="logo" class="w-full h-full object-cover"
            onerror="this.style.display='none'; this.parentNode.innerHTML='<span style=&quot;color:white;font-weight:700;font-size:16px&quot;>S</span>'">
        </div>
        <span
          :class="expanded ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-2'"
          class="text-sm font-semibold tracking-wide text-white/90 leading-tight whitespace-nowrap transition-all duration-200 delay-100"
        >Service Agent<br>Dashboard</span>
      </div>

      <!-- Nav Items -->
      <nav class="flex-1 py-4 flex flex-col gap-0.5 px-2">

        <!-- Home (active) -->
        <div class="relative group">
          <a href="service-agent dashboard page.html" class="flex items-center gap-3 px-2.5 py-3 rounded-xl bg-white/15 transition-all duration-200 cursor-pointer">
            <div class="w-9 h-9 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
            </div>
            <span :class="expanded ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-2'"
              class="text-sm font-medium text-white whitespace-nowrap transition-all duration-200 delay-100">Home</span>
          </a>
          <div v-if="!expanded" class="absolute left-14 top-1/2 -translate-y-1/2 bg-[#0d2844] text-white text-xs px-2.5 py-1.5 rounded-lg shadow-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-150 pointer-events-none z-50">
            Home<div class="absolute right-full top-1/2 -translate-y-1/2 border-4 border-transparent border-r-[#0d2844]"></div>
          </div>
        </div>

        <!-- Analytics -->
        <div class="relative group">
          <a href="analytics page.html" class="flex items-center gap-3 px-2.5 py-3 rounded-xl hover:bg-white/10 transition-all duration-200 cursor-pointer">
            <div class="w-9 h-9 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white/70 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
            </div>
            <span :class="expanded ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-2'"
              class="text-sm font-medium text-white/70 group-hover:text-white whitespace-nowrap transition-all duration-200 delay-100">Analytics</span>
          </a>
          <div v-if="!expanded" class="absolute left-14 top-1/2 -translate-y-1/2 bg-[#0d2844] text-white text-xs px-2.5 py-1.5 rounded-lg shadow-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-150 pointer-events-none z-50">
            Analytics<div class="absolute right-full top-1/2 -translate-y-1/2 border-4 border-transparent border-r-[#0d2844]"></div>
          </div>
        </div>

        <!-- Reports -->
        <div class="relative group">
          <a href="generatereportspage.html" class="flex items-center gap-3 px-2.5 py-3 rounded-xl hover:bg-white/10 transition-all duration-200 cursor-pointer">
            <div class="w-9 h-9 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white/70 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
            </div>
            <span :class="expanded ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-2'"
              class="text-sm font-medium text-white/70 group-hover:text-white whitespace-nowrap transition-all duration-200 delay-100">Reports</span>
          </a>
          <div v-if="!expanded" class="absolute left-14 top-1/2 -translate-y-1/2 bg-[#0d2844] text-white text-xs px-2.5 py-1.5 rounded-lg shadow-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-150 pointer-events-none z-50">
            Reports<div class="absolute right-full top-1/2 -translate-y-1/2 border-4 border-transparent border-r-[#0d2844]"></div>
          </div>
        </div>

        <!-- Pending -->
        <div class="relative group">
          <a href="logs.html" class="flex items-center gap-3 px-2.5 py-3 rounded-xl hover:bg-white/10 transition-all duration-200 cursor-pointer">
            <div class="w-9 h-9 flex items-center justify-center flex-shrink-0 relative">
              <svg class="w-5 h-5 text-white/70 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="absolute -top-0.5 -right-0.5 w-4 h-4 bg-red-500 rounded-full text-[9px] flex items-center justify-center font-bold text-white">3</span>
            </div>
            <span :class="expanded ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-2'"
              class="text-sm font-medium text-white/70 group-hover:text-white whitespace-nowrap transition-all duration-200 delay-100">Logs</span>
          </a>
          <div v-if="!expanded" class="absolute left-14 top-1/2 -translate-y-1/2 bg-[#0d2844] text-white text-xs px-2.5 py-1.5 rounded-lg shadow-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-150 pointer-events-none z-50">
            Logs<div class="absolute right-full top-1/2 -translate-y-1/2 border-4 border-transparent border-r-[#0d2844]"></div>
          </div>
        </div>

      </nav>

      <!-- Logout -->
      <div class="px-2 pb-4 border-t border-white/10 pt-3">
        <div class="relative group">
          <a href="loginpage.html" class="flex items-center gap-3 px-2.5 py-3 rounded-xl hover:bg-red-500/20 transition-all duration-200 cursor-pointer">
            <div class="w-9 h-9 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-white/50 group-hover:text-red-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
            </div>
            <span :class="expanded ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-2'"
              class="text-sm font-medium text-white/50 group-hover:text-red-400 whitespace-nowrap transition-all duration-200 delay-100">Logout</span>
          </a>
          <div v-if="!expanded" class="absolute left-14 top-1/2 -translate-y-1/2 bg-[#0d2844] text-white text-xs px-2.5 py-1.5 rounded-lg shadow-lg whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-150 pointer-events-none z-50">
            Logout<div class="absolute right-full top-1/2 -translate-y-1/2 border-4 border-transparent border-r-[#0d2844]"></div>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col overflow-y-auto">

      <!-- Header -->
      <header class="bg-white px-8 py-4 shadow-sm flex justify-between items-center border-b border-gray-100">
        <div>
          <h1 class="text-xl font-semibold text-[#0d2844]">Welcome Back, Agent 👋</h1>
          <p class="text-xs text-gray-400 mt-0.5">Here's what's happening today</p>
        </div>
        <div class="flex items-center gap-4">
          <!-- Search -->
          <div class="flex items-center gap-2">
            <input
              v-model="search"
              type="text"
              placeholder="Search reports..."
              class="px-4 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 w-56"
            />
            <button class="px-4 py-2 bg-[#0d2844] text-white rounded-xl text-sm font-medium hover:bg-[#0a1f38] transition">
              Search
            </button>
          </div>
          <!-- Avatar -->
          <div class="flex items-center gap-3 bg-[#f0f6ff] px-4 py-2 rounded-full cursor-pointer hover:bg-[#dbeafe] transition">
            <div class="w-8 h-8 rounded-full bg-[#1a4a7a] flex items-center justify-center text-white text-sm font-semibold">N</div>
            <span class="text-sm font-medium text-[#0d2844]">Name</span>
          </div>
        </div>
      </header>

      <!-- Dashboard Content -->
      <section class="p-6 md:p-8 flex-1 overflow-y-auto">

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
          <div v-for="card in statCards" :key="card.label"
            class="bg-white p-5 rounded-2xl shadow-sm flex items-center gap-4 hover:-translate-y-1 hover:shadow-md transition-all duration-200 border border-gray-100">
            <div class="w-14 h-14 rounded-xl flex items-center justify-center text-xl flex-shrink-0" :class="card.bg">
              <span>{{ card.icon }}</span>
            </div>
            <div>
              <p class="text-xs font-medium text-gray-400 mb-1">{{ card.label }}</p>
              <p class="text-2xl font-bold text-[#0d2844]">{{ card.value.toLocaleString() }}</p>
              <p class="text-xs text-green-500 mt-0.5">↑ 0% from last month</p>
            </div>
          </div>
        </div>

        <!-- New Complaint Shortcut -->
        <a
          href="complaintform.html"
          class="group block rounded-2xl border border-indigo-100 bg-gradient-to-r from-[#eef1ff] to-[#f3f5ff] p-10 mb-8 text-center shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
        >
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-white/70 text-[#0d2844] mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <h3 class="text-4xl font-semibold tracking-tight text-[#0d2844]">New Complaint Form</h3>
          <p class="mt-2 text-sm text-gray-500 group-hover:text-gray-600">Click to open complaint entry page</p>
        </a>

        <!-- Pending Reports Table -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="flex justify-between items-center px-6 py-4 border-b border-gray-100">
            <h3 class="text-sm font-semibold text-[#0d2844]">Pending Reports</h3>
            <select v-model="selectedFilter" class="border border-gray-200 rounded-lg px-3 py-1.5 text-xs text-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-300">
              <option>Last 7 days</option>
              <option>Last 30 days</option>
              <option>Last year</option>
            </select>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Report Type</th>
                  <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-50">
                <tr v-for="report in filteredReports" :key="report.date + report.type" class="hover:bg-blue-50/40 transition-colors">
                  <td class="px-6 py-3.5 text-sm text-gray-500">{{ report.date }}</td>
                  <td class="px-6 py-3.5 text-sm text-gray-700 font-medium">{{ report.type }}</td>
                  <td class="px-6 py-3.5">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-yellow-50 text-yellow-700 border border-yellow-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 inline-block"></span>
                      {{ report.status }}
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </section>
    </main>

  </div>

  <script>
    const { createApp } = Vue;
    createApp({
      data() {
        return {
          expanded: false,
          hoverTimer: null,
          search: '',
          selectedFilter: 'Last 7 days',
          statCards: [
            { label: 'Pending',  value: 100000, icon: '⏳', bg: 'bg-blue-50 text-blue-500' },
            { label: 'Resolved', value: 100000, icon: '✓',  bg: 'bg-green-50 text-green-500' },
            { label: 'Approved', value: 100000, icon: '✓',  bg: 'bg-indigo-50 text-indigo-500' },
          ],
          reports: [
            { date: '2026-02-18', type: 'Feedback',                status: 'Pending' },
            { date: '2026-02-20', type: 'Approval for Replacement', status: 'Pending' },
            { date: '2026-02-22', type: 'Defective',               status: 'Pending' },
          ]
        };
      },
      computed: {
        filteredReports() {
          if (!this.search) return this.reports;
          return this.reports.filter(r =>
            r.type.toLowerCase().includes(this.search.toLowerCase()) ||
            r.date.includes(this.search)
          );
        }
      },
      methods: {
        onMouseEnter() { this.hoverTimer = setTimeout(() => { this.expanded = true; }, 600); },
        onMouseLeave() { clearTimeout(this.hoverTimer); this.expanded = false; },
        toggleSidebar() { clearTimeout(this.hoverTimer); this.expanded = !this.expanded; }
      }
    }).mount('#app');
  </script>
</body>
</html>
